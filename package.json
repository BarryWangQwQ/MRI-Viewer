{
  "name": "medical-viewer",
  "version": "0.1.0",
  "description": "Lightweight, embeddable React medical-image viewer — 2D slices, MPR multi-axis, GPU volume rendering, and free-form mask overlays. Built with shadcn/ui. No annotation tooling.",
  "keywords": [
    "medical-imaging",
    "dicom",
    "nifti",
    "ct",
    "mri",
    "viewer",
    "mpr",
    "volume-rendering",
    "react",
    "three",
    "shadcn"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BarryWangQwQ/MRI-Viewer.git"
  },
  "homepage": "https://barrywangqwq.github.io/MRI-Viewer/",
  "bugs": {
    "url": "https://github.com/BarryWangQwQ/MRI-Viewer/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:playground": "vite build --config vite.playground.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "preview:playground": "vite preview --config vite.playground.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dicom-parser": "^1.8.21",
    "lucide-react": "^1.33.0",
    "marching-cubes-fast": "^0.0.172",
    "nifti-reader-js": "^0.8.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.160"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.18.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.182.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
